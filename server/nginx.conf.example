# Add this location to your existing server block.
# If nginx runs on the same server, use 127.0.0.1.
# For nginx on another host, replace the example 192.0.2.10 with your server IP.
location / {
    proxy_pass http://127.0.0.1:8765;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 256k;
    proxy_read_timeout 30s;
}

# For a subpath use a trailing slash in BOTH the location and proxy_pass:
